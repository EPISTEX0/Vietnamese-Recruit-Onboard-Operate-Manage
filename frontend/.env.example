# ===========================================================================
# Vroom HR Frontend — Environment Variables
# ===========================================================================
# Copy this file to .env.local and fill in your values.

# Backend API URL (FastAPI server).
# Used as the base URL for all API calls from lib/api/client.ts.
NEXT_PUBLIC_API_URL=http://localhost:8000

# The URL where the frontend is hosted (used for redirects, CORS).
NEXT_PUBLIC_APP_URL=http://localhost:3000