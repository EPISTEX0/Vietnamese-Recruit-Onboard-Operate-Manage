# ===========================================================================
# Vroom HR Backend — Settings Catalogue (reference, not a template)
# ===========================================================================
# Do NOT copy this file to backend/.env. There is no such file, by design.
#
# python-dotenv's find_dotenv() walks upward from the calling file and stops
# at the FIRST .env it finds; load_dotenv() then reads only that one file.
# A backend/.env would therefore shadow the repo-root .env completely — not
# merged with it, not a fallback for it. Settings absent from backend/.env
# would simply be unset, and the root values would never be read.
#
# The file the backend actually reads is `.env` at the REPO ROOT. Create it
# from the repo root with:  cp .env.example .env
#
# What this file is for: the complete per-module catalogue of every settings
# field, with its default and — for secrets — the command that generates one.
# Look a value up here, then write it into the root `.env`.
#
# Naming convention: <MODULE>_<SETTING>
# See each module's src/modules/<name>/infrastructure/config.py for defaults.

# ---------------------------------------------------------------------------
# Identity / Auth (prefix: AUTH_)
# ---------------------------------------------------------------------------
AUTH_DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/vroom_hr
AUTH_REDIS_URL=redis://localhost:6379/0

# Google OAuth2 — obtain from https://console.cloud.google.com/apis/credentials
AUTH_GOOGLE_CLIENT_ID=
AUTH_GOOGLE_CLIENT_SECRET=
AUTH_GOOGLE_REDIRECT_URI=http://localhost:8000/api/auth/callback

# JWT — generate with: python3 -c "import secrets; print(secrets.token_hex(32))"
AUTH_JWT_SECRET_KEY=
# AUTH_JWT_ALGORITHM=HS256
# AUTH_ACCESS_TOKEN_EXPIRE_MINUTES=15
# AUTH_REFRESH_TOKEN_EXPIRE_DAYS=7

# Encryption key for OAuth tokens — 32 bytes, base64-encoded
# Generate with: python3 -c "import base64, os; print(base64.b64encode(os.urandom(32)).decode())"
AUTH_OAUTH_TOKEN_ENCRYPTION_KEY=

# Rate limiting
# AUTH_RATE_LIMIT_LOGIN_MAX=5
# AUTH_RATE_LIMIT_LOGIN_WINDOW_SECONDS=60

# Admin
# AUTH_SUPER_ADMIN_EMAIL=admin@vroomhr.com

# AI provider deployment key (optional)
# AUTH_AI_DEPLOYMENT_KEY=

# Frontend URL for CORS / redirects
# AUTH_FRONTEND_URL=http://localhost:3000

# ---------------------------------------------------------------------------
# Database (shared fallback for modules without their own DB_ prefix)
# ---------------------------------------------------------------------------
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/vroom_hr

