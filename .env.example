# =============================================================================
# VROOM HR - TOÀN BỘ CẤU HÌNH CHO MÔ HÌNH SELF-HOSTED (LOCAL / PRIVATE SERVER)
# =============================================================================
# Hướng dẫn: 
# 1. Sao chép file này thành file .env: cp .env.example .env
# 2. Thay đổi các chuỗi bí mật (Secret keys & Passwords) ở Mục 2, 3, 4, 5
# 3. Khởi chạy hệ thống: docker compose up -d
# =============================================================================

# -----------------------------------------------------------------------------
# 1. CẤU HÌNH CHUNG & TÊN MIỀN (GENERAL & DOMAIN CONFIGURATION)
# -----------------------------------------------------------------------------
# Tên miền hoặc IP truy cập giao diện Frontend
VROOM_HOST=localhost
VROOM_PORT=3000

# Port dịch vụ Backend API nội bộ
BACKEND_PORT=8000

# Môi trường chạy (production / development)
ENVIRONMENT=production

# -----------------------------------------------------------------------------
# 2. BẢO MẬT & XÁC THỰC (SECURITY & AUTHENTICATION - BẮT BUỘC ĐỔI KHI DEPLOY)
# -----------------------------------------------------------------------------
# JWT Secret Key - Tạo ngẫu nhiên bằng lệnh: python3 -c "import secrets; print(secrets.token_hex(32))"
AUTH_JWT_SECRET_KEY=change_this_to_a_secure_random_jwt_secret_key_vroom2026
AUTH_PASSWORD_SALT=change_this_to_a_secure_random_salt_vroom2026

# AES-256-GCM key dùng để mã hóa OAuth token (base64 của 32 bytes) — BẮT BUỘC ĐỔI. Generate bằng: openssl rand -base64 32
AUTH_OAUTH_TOKEN_ENCRYPTION_KEY=AgkItkBflb0chFc48tqOqHPWABOtUUnqmqoTBqKLpmg=

# Thuật toán mã hóa JWT & thời hạn token
AUTH_JWT_ALGORITHM=HS256
AUTH_ACCESS_TOKEN_EXPIRE_MINUTES=15
AUTH_REFRESH_TOKEN_EXPIRE_DAYS=7

# Email Admin tối cao tự động tạo khi chạy lần đầu
AUTH_SUPER_ADMIN_EMAIL=admin@vroomhr.com

# -----------------------------------------------------------------------------
# 3. CƠ SỞ DỮ LIỆU POSTGRESQL (+ PGVECTOR)
# -----------------------------------------------------------------------------
POSTGRES_USER=postgres
POSTGRES_PASSWORD=VroomSecurePass2026!
POSTGRES_DB=vroom_hr
POSTGRES_PORT=5432

# -----------------------------------------------------------------------------
# 4. REDIS CACHE & QUEUE BROKER
# -----------------------------------------------------------------------------
REDIS_PASSWORD=VroomRedisPass2026!
REDIS_PORT=6379

# -----------------------------------------------------------------------------
# 5. KHO LƯU TRỮ FILE MINIO (OBJECT STORAGE)
# -----------------------------------------------------------------------------
MINIO_ROOT_USER=vroomminio
MINIO_ROOT_PASSWORD=VroomMinioPass2026!
MINIO_API_PORT=9000
MINIO_CONSOLE_PORT=9001

# Dynamic MinIO Presigned URLs (Để trống sẽ dùng Host request)
EMPLOYEE_MINIO_PUBLIC_ENDPOINT=
RECRUITMENT_MINIO_PUBLIC_ENDPOINT=
KB_MINIO_PUBLIC_ENDPOINT=

# -----------------------------------------------------------------------------
# 6. DỊCH VỤ AI EMBEDDING (ENDPOINT OPENAI-COMPATIBLE)
# -----------------------------------------------------------------------------
# vroom-embedding không tự chạy model nào — nó chuyển tiếp tới một endpoint
# OpenAI-compatible `/embeddings` do bạn chỉ định, cùng mô hình cấu hình với
# RECRUITMENT_LLM_BASE_URL / ASSISTANT_LLM_BASE_URL.
#
# BẮT BUỘC. Không có giá trị mặc định: repo không chọn nhà cung cấp thay bạn.
# Để trống thì service sẽ dừng ngay lúc khởi động kèm hướng dẫn cụ thể.
#
# Đặt bằng base URL của endpoint — phần đứng trước `/embeddings`, thường kết
# thúc bằng `/v1`. Hai hướng đều dùng được:
#
#   a) Endpoint chạy trong hạ tầng của bạn (vLLM, TEI, LocalAI...), thường
#      không cần key — dữ liệu tài liệu không rời hệ thống:
#        EMBEDDING_API_BASE_URL=http://vllm:8000/v1
#        EMBEDDING_API_KEY=
#
#   b) Một API OpenAI-compatible dạng hosted, cần key. Ví dụ (chỉ là ví dụ,
#      không phải khuyến nghị): https://api.ai-box.vn/v1 với model
#      `text-embedding-v4`, hoặc bất kỳ nhà cung cấp nào bạn chọn:
#        EMBEDDING_API_BASE_URL=https://api.your-provider.example/v1
#        EMBEDDING_API_KEY=sk-...
EMBEDDING_API_BASE_URL=
# Để trống nếu endpoint không yêu cầu xác thực. Chỉ base URL là bắt buộc.
EMBEDDING_API_KEY=
# BẮT BUỘC, không có mặc định: tên model phụ thuộc vào endpoint bạn chọn, và
# repo không chọn nhà cung cấp thay bạn. Đặt đúng tên mà endpoint của bạn dùng.
# Ví dụ: `BAAI/bge-m3` cho một endpoint nội bộ (vLLM/TEI), hoặc
# `text-embedding-3-small` cho một API hosted.
# Để trống thì service dừng ngay lúc khởi động — thay vì để lỗi này hoá trang
# thành 502 "model not found" từ upstream lúc chạy.
EMBEDDING_MODEL_NAME=
# Phải khớp cột pgvector Vector(1024). Service kiểm tra lúc khởi động và sẽ
# dừng ngay nếu provider trả về số chiều khác.
EMBEDDING_DIMENSIONS=1024
# Số text tối đa mỗi request lên endpoint. Giới hạn này tuỳ nhà cung cấp —
# hạ xuống nếu endpoint của bạn trả lỗi "batch size" (ai-box giới hạn 10).
EMBEDDING_BATCH_SIZE=10
# Mặc định được chọn sao cho tổng thời gian retry vẫn nằm dưới 30s mà phía
# retrieval cho phép — quá ngưỡng đó thì caller đã bỏ cuộc trước khi có kết quả.
EMBEDDING_TIMEOUT=12
EMBEDDING_MAX_RETRIES=1
# Đặt false nếu endpoint từ chối tham số `dimensions` (ví dụ vLLM với model
# không hỗ trợ Matryoshka).
EMBEDDING_SEND_DIMENSIONS=true
EMBEDDING_PORT=8080

# -----------------------------------------------------------------------------
# 7. TÍCH HỢP BÊN NGOÀI GOOGLE WORKSPACE OAUTH2 (TÙY CHỌN CHỈ KHI DÙNG GMAIL/CALENDAR)
# -----------------------------------------------------------------------------
# Đăng ký App trên Google Cloud Console: https://console.cloud.google.com/apis/credentials
AUTH_GOOGLE_CLIENT_ID=
AUTH_GOOGLE_CLIENT_SECRET=
AUTH_GOOGLE_REDIRECT_URI=http://localhost:8000/api/auth/callback
