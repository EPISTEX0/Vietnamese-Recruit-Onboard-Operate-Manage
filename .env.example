# =============================================================================
# VROOM HR - TOÀN BỘ CẤU HÌNH CHO MÔ HÌNH SELF-HOSTED (LOCAL / PRIVATE SERVER)
# =============================================================================
# Hướng dẫn: 
# 1. Sao chép file này thành file .env: cp .env.example .env
# 2. Thay đổi các chuỗi bí mật (Secret keys & Passwords) ở Mục 2, 3, 4, 5
# 3. Khởi chạy hệ thống: docker compose up -d
# =============================================================================

# -----------------------------------------------------------------------------
# 1. CẤU HÌNH CHUNG & TÊN MIỀN (GENERAL & DOMAIN CONFIGURATION)
# -----------------------------------------------------------------------------
# Tên miền hoặc IP truy cập giao diện Frontend
VROOM_HOST=localhost
VROOM_PORT=3000

# Port dịch vụ Backend API nội bộ
BACKEND_PORT=8000

# Môi trường chạy (production / development)
ENVIRONMENT=production

# -----------------------------------------------------------------------------
# 2. BẢO MẬT & XÁC THỰC (SECURITY & AUTHENTICATION - BẮT BUỘC ĐỔI KHI DEPLOY)
# -----------------------------------------------------------------------------
# JWT Secret Key - Tạo ngẫu nhiên bằng lệnh: python3 -c "import secrets; print(secrets.token_hex(32))"
AUTH_JWT_SECRET_KEY=change_this_to_a_secure_random_jwt_secret_key_vroom2026
AUTH_PASSWORD_SALT=change_this_to_a_secure_random_salt_vroom2026

# AES-256-GCM key dùng để mã hóa OAuth token (base64 của 32 bytes) — BẮT BUỘC ĐỔI. Generate bằng: openssl rand -base64 32
AUTH_OAUTH_TOKEN_ENCRYPTION_KEY=AgkItkBflb0chFc48tqOqHPWABOtUUnqmqoTBqKLpmg=

# Thuật toán mã hóa JWT & thời hạn token
AUTH_JWT_ALGORITHM=HS256
AUTH_ACCESS_TOKEN_EXPIRE_MINUTES=15
AUTH_REFRESH_TOKEN_EXPIRE_DAYS=7

# Email Admin tối cao tự động tạo khi chạy lần đầu
AUTH_SUPER_ADMIN_EMAIL=admin@vroomhr.com

# -----------------------------------------------------------------------------
# 3. CƠ SỞ DỮ LIỆU POSTGRESQL (+ PGVECTOR)
# -----------------------------------------------------------------------------
POSTGRES_USER=postgres
POSTGRES_PASSWORD=VroomSecurePass2026!
POSTGRES_DB=vroom_hr
POSTGRES_PORT=5432

# -----------------------------------------------------------------------------
# 4. REDIS CACHE & QUEUE BROKER
# -----------------------------------------------------------------------------
REDIS_PASSWORD=VroomRedisPass2026!
REDIS_PORT=6379

# -----------------------------------------------------------------------------
# 5. KHO LƯU TRỮ FILE MINIO (OBJECT STORAGE)
# -----------------------------------------------------------------------------
MINIO_ROOT_USER=vroomminio
MINIO_ROOT_PASSWORD=VroomMinioPass2026!
MINIO_API_PORT=9000
MINIO_CONSOLE_PORT=9001

# Dynamic MinIO Presigned URLs (Để trống sẽ dùng Host request)
EMPLOYEE_MINIO_PUBLIC_ENDPOINT=
RECRUITMENT_MINIO_PUBLIC_ENDPOINT=
KB_MINIO_PUBLIC_ENDPOINT=

# -----------------------------------------------------------------------------
# 6. DỊCH VỤ AI EMBEDDING (VIETNAMESE EMBEDDING V2)
# -----------------------------------------------------------------------------
EMBEDDING_MODEL_NAME=AITeamVN/Vietnamese_Embedding_v2
EMBEDDING_PORT=8080
# Hugging Face User Access Token (Tuỳ chọn nếu model yêu cầu authentication)
HF_TOKEN=

# -----------------------------------------------------------------------------
# 7. TÍCH HỢP BÊN NGOÀI GOOGLE WORKSPACE OAUTH2 (TÙY CHỌN CHỈ KHI DÙNG GMAIL/CALENDAR)
# -----------------------------------------------------------------------------
# Đăng ký App trên Google Cloud Console: https://console.cloud.google.com/apis/credentials
AUTH_GOOGLE_CLIENT_ID=
AUTH_GOOGLE_CLIENT_SECRET=
AUTH_GOOGLE_REDIRECT_URI=http://localhost:8000/api/auth/callback
